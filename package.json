{
  "name": "ngrx-undo-v2",
  "version": "20.0.0",
  "description": "Undo support for @ngrx/store",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pilz97/ngrx-undo.git"
  },
  "author": "Brecht Billiet <billietbrecht@gmail.com> (http://www.brecht.io/)",
  "engines": {
    "node": ">= 18.18.0",
    "npm": ">= 9"
  },
  "scripts": {
    "karma": "karma start --single-run",
    "clean:pre": "rimraf release",
    "clean:post": "rimraf src/**/*.ngfactory.ts",
    "copy": "cpy LICENSE package.json README.md release",
    "buildprod:js": "ngc -p tsconfig.dist.json",
    "buildprod:umd": "rollup -c rollup.config.js",
    "buildprod:uglify": "uglifyjs -c --screw-ie8 --comments -o ./release/bundles/ngrx-undo.min.umd.js ./release/bundles/ngrx-undo.umd.js",
    "prebuildprod": "npm run clean:pre",
    "postbuildprod": "npm run clean:post && npm run copy",
    "buildprod": "npm run buildprod:js && npm run buildprod:umd && npm run buildprod:uglify",
    "deploy": "npm run buildprod && cd ./release && npm publish"
  },
  "main": "./bundles/ngrx-undo.umd.js",
  "module": "./index.js",
  "devDependencies": {
    "@angular/compiler": "20.3.15",
    "@angular/compiler-cli": "20.3.15",
    "@angular/core": "20.3.15",
    "@ngrx/store": "20.1.0",
    "@types/node": "^20.11.30",
    "awesome-typescript-loader": "^2.2.1",
    "core-js": "^2.4.1",
    "cpy-cli": "^1.0.1",
    "rimraf": "2.5.4",
    "rollup": "^0.34.13",
    "rxjs": "^7.8.1",
    "ts-loader": "^0.8.2",
    "tslint": "^3.15.1",
    "tslint-loader": "^2.1.5",
    "typescript": "~5.8.2",
    "uglify-js": "^3.4.9",
    "zone.js": "~0.15.0"
  },
  "peerDependencies": {
    "@ngrx/store": "20.1.0"
  },
  "bugs": {
    "url": "https://github.com/pilz97/ngrx-undo/issues"
  },
  "homepage": "https://github.com/pilz97/ngrx-undo#readme"
}
